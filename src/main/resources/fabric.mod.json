{
  "schemaVersion": 1,
  "id": "autopalette",
  "version": "${version}",
  "name": "AutoPalette",
  "description": "A client-side mod to automatically draw images on ArtMap canvases.",
  "authors": [
    "suoim"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/autopalette"
  },
  "license": "Apache-2.0 AND MIT",
  "icon": "assets/autopalette/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.example.autopalette.ArtMapDraw"
    ],
    "client": [
      "com.example.autopalette.client.ArtMapDrawClient"
    ]
  },
  "mixins": [
    "autopalette.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "26.2",
    "fabric-api": "*",
    "java": ">=25"
  }
}